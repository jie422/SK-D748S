#!/bin/sh
echo "=== 开始配置 WAN2LAN (IPv4+IPv6 自动DNS) ==="
echo "等待 WiFi 接口启动..."
WAIT=0
while [ $WAIT -lt 30 ]; do
    if ifconfig | grep -q "ra0"; then
        echo "✅ WiFi 接口已就绪"
        break
    fi
    sleep 2
    WAIT=$(expr $WAIT + 2)
done
[ $WAIT -ge 30 ] && echo "⚠️ WiFi 未在30秒内出现，继续执行..."
sleep 3

echo "=== 停止网络 ==="
/etc/init.d/network stop 2>/dev/null
sleep 2

echo "=== 配置 IPv4 网络 ==="
brctl delif br0 eth0.1 2>/dev/null
ifconfig eth0.1 192.168.1.184 netmask 255.255.255.0 up
ip route del default 2>/dev/null
ip route add default via 192.168.1.1 dev eth0.1
echo 1 > /proc/sys/net/ipv4/ip_forward
echo 0 > /proc/sys/net/ipv4/conf/all/rp_filter

echo "=== 配置 IPv6 ==="
echo 1 > /proc/sys/net/ipv6/conf/all/forwarding
echo 1 > /proc/sys/net/ipv6/conf/eth0.1/forwarding
echo 1 > /proc/sys/net/ipv6/conf/br0/forwarding
echo 2 > /proc/sys/net/ipv6/conf/eth0.1/accept_ra
echo 1 > /proc/sys/net/ipv6/conf/eth0.1/autoconf
echo 1 > /proc/sys/net/ipv6/conf/br0/autoconf
echo 0 > /proc/sys/net/ipv6/conf/all/rp_filter 2>/dev/null

echo "=== 启动 DHCPv6 客户端 ==="
if [ -f /usr/sbin/dhcp6c ]; then
    /usr/sbin/dhcp6c -d eth0.1 &
elif [ -f /usr/bin/dhcp6c ]; then
    /usr/bin/dhcp6c -d eth0.1 &
elif [ -f /usr/sbin/odhcp6c ]; then
    /usr/sbin/odhcp6c -d eth0.1 &
elif [ -f /usr/bin/odhcp6c ]; then
    /usr/bin/odhcp6c -d eth0.1 &
else
    echo "⚠️ 未找到 DHCPv6 客户端"
fi

sleep 5

echo "=== IPv6 地址信息 ==="
ip -6 addr show eth0.1 | grep -E "inet6|scope"

echo "=== 配置 DNS (IPv4 + IPv6 自动获取) ==="
echo "nameserver 1.2.4.8" > /etc/resolv.conf
echo "nameserver 8.8.8.8" >> /etc/resolv.conf
echo "nameserver 114.114.114.114" >> /etc/resolv.conf
echo "nameserver 223.5.5.5" >> /etc/resolv.conf

# 从 DHCPv6 获取 DNS
if [ -f /var/lib/dhcp6c/dhcp6c_lease ]; then
    echo "从 DHCPv6 获取 DNS..."
    grep -i "nameserver" /var/lib/dhcp6c/dhcp6c_lease 2>/dev/null | head -2 >> /etc/resolv.conf
elif [ -f /tmp/dhcp6c_lease ]; then
    echo "从 DHCPv6 获取 DNS..."
    grep -i "nameserver" /tmp/dhcp6c_lease 2>/dev/null | head -2 >> /etc/resolv.conf
fi

# 从 RDNSS 获取 DNS
for f in /tmp/radvd.conf /var/run/radvd.conf /tmp/rdnss.conf; do
    if [ -f "$f" ]; then
        echo "从 RDNSS 获取 DNS..."
        grep -i "nameserver" "$f" 2>/dev/null | head -2 >> /etc/resolv.conf
    fi
done

echo "=== 最终 DNS 配置 ==="
cat /etc/resolv.conf

echo "=== 配置防火墙 ==="
iptables -t nat -F
iptables -F
iptables -t nat -A POSTROUTING -o eth0.1 -j MASQUERADE
iptables -P FORWARD ACCEPT
iptables -A FORWARD -i br0 -o eth0.1 -j ACCEPT
iptables -A FORWARD -i eth0.1 -o br0 -j ACCEPT

if [ -f /usr/sbin/ip6tables ]; then
    echo "配置 IPv6 防火墙..."
    ip6tables -F
    ip6tables -P FORWARD ACCEPT
    ip6tables -A FORWARD -i br0 -o eth0.1 -j ACCEPT
    ip6tables -A FORWARD -i eth0.1 -o br0 -j ACCEPT
fi

echo "=== 停用光口 ==="
ifconfig oam down 2>/dev/null
ifconfig omci down 2>/dev/null
ifconfig pon down 2>/dev/null

echo "=== 重启网络 ==="
/etc/init.d/network restart 2>/dev/null
sleep 3

echo ""
echo "✅ 配置完成！LAN1 为 WAN 口，其他口为 LAN 口"
echo "📌 IPv4 WAN IP: 192.168.1.184"
echo "📌 LAN IP: 192.168.2.1"
echo ""
echo "=== 测试 IPv4 网络 ==="
ping -c 2 baidu.com || echo "⚠️ IPv4 网络测试失败"

echo ""
echo "=== 测试 IPv6 网络 ==="
ping -6 -c 2 2400:3200::1 2>/dev/null || echo "⚠️ IPv6 测试失败（可能上级不支持）"
ping -6 -c 2 ipv6.baidu.com 2>/dev/null || echo "⚠️ IPv6 DNS 解析失败"
